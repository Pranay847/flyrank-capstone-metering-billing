# Copy to .env (git-ignored) and fill in. Every variable the app reads is listed here.

# Database. Docker Compose overrides this with its Postgres; this default is for local runs.
DATABASE_URL=sqlite:///./billing.db

# Protects POST /tenants. Any long random string.
ADMIN_TOKEN=change-me-to-a-long-random-string

# Stripe TEST mode only — the app refuses sk_live_ keys.
STRIPE_SECRET_KEY=sk_test_replace_me
# Printed by `stripe listen --forward-to localhost:8000/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Printed by `python -m app.stripe_setup`
STRIPE_PRICE_PRO=price_replace_me

# Where Stripe Checkout sends the customer back to.
PUBLIC_BASE_URL=http://localhost:8000

# Background worker (usage alerts). Leave on.
RUN_WORKER=true
WORKER_POLL_SECONDS=2
